# MongoDB connection string (get this from MongoDB Atlas after creating a cluster)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DB_NAME=ashnee

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev example: http://localhost:3000
# Production example: https://ashnee.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# Resend (https://resend.com) - used to send contact/newsletter email alerts
# Free tier: get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDER_EMAIL=onboarding@resend.dev
ALERT_EMAIL=you@example.com
